@model proyecto_programacion_avanzada.ViewModels.Visitante.VisitanteDetailsViewModel

@{
    ViewBag.Title = "Registrar Salida de Visitante";
}

<div class="card shadow mx-auto" style="max-width: 640px;">
    <div class="card-header bg-warning text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-sign-out-alt me-2"></i>Registrar Salida de Visitante</h2>
    </div>

    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            ¿Confirma el registro de salida para este visitante?
        </div>

        <dl class="dl-condominio">
            <dt>Nombre</dt>
            <dd>@Model.Nombre</dd>

            <dt>Identificación</dt>
            <dd>@Model.Identificacion</dd>

            <dt>Tipo</dt>
            <dd>@Model.Tipo</dd>

            <dt>Vivienda</dt>
            <dd>@Model.NombreVivienda</dd>

            <dt>Fecha de Ingreso</dt>
            <dd>@Model.FechaIngreso.ToString("g")</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-warning">
                    <i class="fas fa-sign-out-alt me-1"></i>Registrar salida
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Cancelar</a>
            </div>
        }
    </div>
</div>

