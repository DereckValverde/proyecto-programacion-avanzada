@using proyecto_programacion_avanzada.Common.Enums;
@model IEnumerable<proyecto_programacion_avanzada.ViewModels.Visitante.VisitanteListViewModel>

@{
    ViewBag.Title = "Visitantes";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2><i class="fas fa-user-tag me-2"></i>Visitantes y Proveedores</h2>

    <div class="d-flex gap-2 align-items-center">
        <div class="btn-group" role="group">
            @Html.ActionLink("Todos", "Index", null,
                new { @class = "btn btn-sm btn-outline-secondary" + (ViewBag.Filtro == null ? " active" : "") })

            @Html.ActionLink("Dentro del condominio", "Index", new { filtro = "activos" },
                new { @class = "btn btn-sm btn-outline-secondary" + ((string)ViewBag.Filtro == "activos" ? " active" : "") })
        </div>

        @Html.ActionLink(" Registrar ingreso", "Create", null,
            new { @class = "btn btn-primary" })
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-user-tag"></i>
                No hay visitantes registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Identificación</th>
                            <th>Tipo</th>
                            <th>Vivienda</th>
                            <th>Fecha Ingreso</th>
                            <th>Fecha Salida</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.Identificacion</td>
                                <td>@item.TipoNombre</td>
                                <td>@item.NombreVivienda</td>
                                <td>@item.FechaIngreso.ToString("g")</td>
                                <td>@(item.FechaSalida.HasValue ? item.FechaSalida.Value.ToString("g") : "-")</td>
                                <td>
                                    @if (item.SeEncuentraDentro)
                                    {
                                        <span class="badge bg-success">Dentro</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Salió</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Details", new { id = item.IdVisitante },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @if (item.SeEncuentraDentro)
                                    {
                                        @Html.ActionLink(" ", "RegistrarSalida", new { id = item.IdVisitante },
                                            new { @class = "btn btn-sm btn-outline-warning btn-action fas fa-sign-out-alt", title = "Registrar salida" })
                                    }

                                    @Html.ActionLink(" ", "Edit", new { id = item.IdVisitante },
                                        new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })

                                    @Html.ActionLink(" ", "Delete", new { id = item.IdVisitante },
                                        new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
