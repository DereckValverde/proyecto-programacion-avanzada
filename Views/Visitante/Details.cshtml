@model Condominio.Application.ViewModels.Visitante.VisitanteDetailsViewModel

@{
    ViewBag.Title = "Detalle del Visitante";
}

<div class="card shadow mx-auto" style="max-width: 640px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-user-tag me-2"></i>Detalle del Visitante</h2>
    </div>

    <div class="card-body">
        <dl class="dl-condominio">
            <dt>Nombre</dt>
            <dd>@Model.Nombre</dd>

            <dt>Identificación</dt>
            <dd>@Model.Identificacion</dd>

            <dt>Tipo</dt>
            <dd>@Model.Tipo</dd>

            <dt>Vivienda</dt>
            <dd>@Model.NombreVivienda</dd>

            <dt>Fecha de Ingreso</dt>
            <dd>@Model.FechaIngreso.ToString("g")</dd>

            <dt>Fecha de Salida</dt>
            <dd>@(Model.FechaSalida.HasValue ? Model.FechaSalida.Value.ToString("g") : "Aún dentro del condominio")</dd>

            <dt>Estado</dt>
            <dd>
                @if (Model.SeEncuentraDentro)
                {
                    <span class="badge bg-success">Dentro</span>
                }
                else
                {
                    <span class="badge bg-secondary">Salió</span>
                }
            </dd>
        </dl>

        <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
            @if (Model.SeEncuentraDentro)
            {
                <a href="@Url.Action("RegistrarSalida", new { id = Model.IdVisitante })" class="btn btn-warning">
                    <i class="fas fa-sign-out-alt me-1"></i> Registrar salida
                </a>
            }

            <a href="@Url.Action("Edit", new { id = Model.IdVisitante })" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i> Editar
            </a>

            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
        </div>
    </div>
</div>

