@model proyecto_programacion_avanzada.ViewModels.AreaComun.AreaComunEditViewModel

@{
    ViewBag.Title = "Editar Área Común";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>
                        Editar Área Común
                    </h4>
                </div>

                <div class="card-body">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(x => x.IdArea)

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(x => x.Nombre, new { @class = "form-label" })

                            @Html.TextBoxFor(
                                x => x.Nombre,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Ejemplo: Piscina"
                                })

                            @Html.ValidationMessageFor(
                                x => x.Nombre,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(
                                x => x.Descripcion,
                                new { @class = "form-label" })

                            @Html.TextAreaFor(
                                x => x.Descripcion,
                                new
                                {
                                    @class = "form-control",
                                    rows = 3,
                                    placeholder = "Descripción del área"
                                })

                            @Html.ValidationMessageFor(
                                x => x.Descripcion,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(
                                x => x.Capacidad,
                                new { @class = "form-label" })

                            @Html.TextBoxFor(
                                x => x.Capacidad,
                                new
                                {
                                    @class = "form-control",
                                    type = "number",
                                    min = "1"
                                })

                            @Html.ValidationMessageFor(
                                x => x.Capacidad,
                                "",
                                new { @class = "text-danger" })
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(
                                    x => x.HoraApertura,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    x => x.HoraApertura,
                                    "{0:hh\\:mm}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "time"
                                    })

                                @Html.ValidationMessageFor(
                                    x => x.HoraApertura,
                                    "",
                                    new { @class = "text-danger" })
                            </div>

                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(
                                    x => x.HoraCierre,
                                    new { @class = "form-label" })

                                @Html.TextBoxFor(
                                    x => x.HoraCierre,
                                    "{0:hh\\:mm}",
                                    new
                                    {
                                        @class = "form-control",
                                        type = "time"
                                    })

                                @Html.ValidationMessageFor(
                                    x => x.HoraCierre,
                                    "",
                                    new { @class = "text-danger" })
                            </div>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-end gap-2">

                            @Html.ActionLink(
                                " Cancelar",
                                "Index",
                                null,
                                new
                                {
                                    @class = "btn btn-secondary bi bi-arrow-left-circle"
                                })

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Actualizar
                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}