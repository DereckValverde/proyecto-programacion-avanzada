@model proyecto_programacion_avanzada.ViewModels.AreaComun.AreaComunDetailsViewModel

@{
    ViewBag.Title = "Detalles del Área Común";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-info text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-eye-fill me-2"></i>
                        Detalles del Área Común
                    </h4>
                </div>

                <div class="card-body">

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.Nombre)
                        </div>

                        <div class="col-md-8">
                            @Html.DisplayFor(x => x.Nombre)
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.Descripcion)
                        </div>

                        <div class="col-md-8">
                            @if (string.IsNullOrWhiteSpace(Model.Descripcion))
                            {
                                <span class="text-muted">Sin descripción</span>
                            }
                            else
                            {
                                @Model.Descripcion
                            }
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.Capacidad)
                        </div>

                        <div class="col-md-8">
                            @Model.Capacidad personas
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.HoraApertura)
                        </div>

                        <div class="col-md-8">
                            @Model.HoraApertura.ToString(@"hh\:mm")
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.HoraCierre)
                        </div>

                        <div class="col-md-8">
                            @Model.HoraCierre.ToString(@"hh\:mm")
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">

                        @Html.ActionLink(
                            " Volver",
                            "Index",
                            null,
                            new
                            {
                                @class = "btn btn-secondary bi bi-arrow-left-circle"
                            })

                        @Html.ActionLink(
                            " Editar",
                            "Edit",
                            new { id = Model.IdArea },
                            new
                            {
                                @class = "btn btn-warning bi bi-pencil-square"
                            })

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>