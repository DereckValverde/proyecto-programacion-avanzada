@model proyecto_programacion_avanzada.ViewModels.AreaComun.AreaComunDetailsViewModel

@{
    ViewBag.Title = "Eliminar Área Común";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Eliminar Área Común
                    </h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                        ¿Está seguro de que desea eliminar esta área común?
                        Esta acción no se puede deshacer.
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.Nombre)
                        </div>

                        <div class="col-md-8">
                            @Html.DisplayFor(x => x.Nombre)
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.Descripcion)
                        </div>

                        <div class="col-md-8">
                            @if (string.IsNullOrWhiteSpace(Model.Descripcion))
                            {
                                <span class="text-muted">Sin descripción</span>
                            }
                            else
                            {
                                @Model.Descripcion
                            }
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            @Html.DisplayNameFor(x => x.Capacidad)
                        </div>

                        <div class="col-md-8">
                            @Model.Capacidad personas
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Horario
                        </div>

                        <div class="col-md-8">
                            @Model.HoraApertura.ToString(@"hh\:mm")
                            -
                            @Model.HoraCierre.ToString(@"hh\:mm")
                        </div>
                    </div>

                    <hr />

                    @using (Html.BeginForm("Delete", "AreaComun", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(x => x.IdArea)

                        <div class="d-flex justify-content-end gap-2">

                            @Html.ActionLink(
                                " Cancelar",
                                "Index",
                                null,
                                new
                                {
                                    @class = "btn btn-secondary bi bi-arrow-left-circle"
                                })

                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-1"></i>
                                Eliminar definitivamente
                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>
</div>