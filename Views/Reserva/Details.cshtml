@model Condominio.Application.ViewModels.Reserva.ReservaDetailsViewModel

@{
    ViewBag.Title = "Detalle de la Reserva";
}

<div class="card shadow mx-auto" style="max-width: 640px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-calendar-check me-2"></i>Detalle de la Reserva</h2>
    </div>

    <div class="card-body">
        <dl class="dl-condominio">
            <dt>Vivienda</dt>
            <dd>@Model.NombreVivienda</dd>

            <dt>Área Común</dt>
            <dd>@Model.NombreArea</dd>

            <dt>Fecha</dt>
            <dd>@Model.FechaReserva.ToString("d")</dd>

            <dt>Horario</dt>
            <dd>@Model.HoraInicio.ToString(@"hh\:mm") - @Model.HoraFin.ToString(@"hh\:mm")</dd>

            <dt>Estado</dt>
            <dd>
                @if (Model.Estado == Condominio.Domain.Enums.EstadoReserva.Confirmada)
                {
                    <span class="badge bg-success">@Model.Estado</span>
                }
                else if (Model.Estado == Condominio.Domain.Enums.EstadoReserva.Cancelada)
                {
                    <span class="badge bg-danger">@Model.Estado</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">@Model.Estado</span>
                }
            </dd>
        </dl>

        <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
            <a href="@Url.Action("Edit", new { id = Model.IdReserva })" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i> Editar
            </a>

            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
        </div>
    </div>
</div>
