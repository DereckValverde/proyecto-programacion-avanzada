@model Condominio.Application.Reservas.ReservaDetailsViewModel

@{
    ViewBag.Title = "Cancelar Reserva";
}

<div class="card shadow mx-auto" style="max-width: 640px;">
    <div class="card-header bg-warning text-dark">
        <h2 class="page-heading mb-0"><i class="fas fa-times-circle me-2"></i>Cancelar Reserva</h2>
    </div>

    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            ¿Está seguro de que desea cancelar esta reserva?
        </div>

        <dl class="dl-condominio">
            <dt>Vivienda</dt>
            <dd>@Model.NombreVivienda</dd>

            <dt>Área Común</dt>
            <dd>@Model.NombreArea</dd>

            <dt>Fecha</dt>
            <dd>@Model.FechaReserva.ToString("d")</dd>

            <dt>Horario</dt>
            <dd>@Model.HoraInicio.ToString(@"hh\:mm") - @Model.HoraFin.ToString(@"hh\:mm")</dd>

            <dt>Estado</dt>
            <dd>@Model.Estado</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-warning">
                    <i class="fas fa-times me-1"></i>Cancelar reserva
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>
