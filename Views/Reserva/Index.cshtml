@model IEnumerable<Condominio.Application.ViewModels.Reserva.ReservaListViewModel>

@{
    ViewBag.Title = "Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2><i class="fas fa-calendar-check me-2"></i>Reservas</h2>

    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nueva reserva
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-calendar-check"></i>
                No hay reservas registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Vivienda</th>
                            <th>Área Común</th>
                            <th>Fecha</th>
                            <th>Horario</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.NombreVivienda</td>
                                <td>@item.NombreArea</td>
                                <td>@item.FechaReserva.ToString("d")</td>
                                <td>@item.HoraInicio.ToString(@"hh\:mm") - @item.HoraFin.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (item.Estado == Condominio.Domain.Enums.EstadoReserva.Confirmada)
                                    {
                                        <span class="badge bg-success">@item.EstadoNombre</span>
                                    }
                                    else if (item.Estado == Condominio.Domain.Enums.EstadoReserva.Cancelada)
                                    {
                                        <span class="badge bg-danger">@item.EstadoNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.EstadoNombre</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Details", new { id = item.IdReserva },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @Html.ActionLink(" ", "Edit", new { id = item.IdReserva },
                                        new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })

                                    @Html.ActionLink(" ", "Delete", new { id = item.IdReserva },
                                        new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
