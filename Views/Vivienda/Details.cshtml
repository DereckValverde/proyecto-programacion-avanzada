@model Condominio.Application.Viviendas.ViviendaDetailsViewModel

@{
    ViewBag.Title = "Detalles Vivienda";
}

<div class="card shadow mx-auto" style="max-width: 640px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-home me-2"></i>Detalles Vivienda</h2>
    </div>

    <div class="card-body">
        <dl class="dl-condominio">
            <dt>Número</dt>
            <dd>@Model.Numero</dd>

            <dt>Bloque</dt>
            <dd>@Model.Bloque</dd>

            <dt>Tipo</dt>
            <dd>@Model.Tipo</dd>

            <dt>Estado</dt>
            <dd><span class="badge bg-success">@Model.Estado</span></dd>
        </dl>

        <div class="d-flex justify-content-center gap-2 mt-4">
            <a href="@Url.Action("Edit", new { id = Model.IdVivienda })" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Editar
            </a>

            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
        </div>
    </div>
</div>

