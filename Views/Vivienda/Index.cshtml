@using Condominio.Domain.Enums;
@model IEnumerable<Condominio.Application.ViewModels.Vivienda.ViviendaListViewModel>

@{
    ViewBag.Title = "Viviendas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-home me-2"></i>Gestión de Viviendas</h2>

    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-home me-1"></i>Nueva Vivienda
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-home"></i>
                No hay viviendas registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Número</th>
                            <th>Bloque</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Numero</td>
                                <td>@item.Bloque</td>
                                <td>@item.TipoNombre</td>
                                <td>
                                    @if (item.Estado == EstadoGeneral.Activo)
                                    {
                                        <span class="badge bg-success">@item.EstadoNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.EstadoNombre</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Edit", new { id = item.IdVivienda },
                                        new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })

                                    @Html.ActionLink(" ", "Details", new { id = item.IdVivienda },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @Html.ActionLink(" ", "Delete", new { id = item.IdVivienda },
                                        new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
