@model Condominio.Application.ViewModels.Vivienda.ViviendaCreateViewModel
@using Condominio.Domain.Enums

@{
    ViewBag.Title = "Crear Vivienda";
}

<div class="card shadow mx-auto" style="max-width: 760px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-home me-2"></i>Crear Vivienda</h2>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(x => x.Bloque)
                @Html.TextBoxFor(x => x.Bloque, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.Bloque, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Numero)
                @Html.TextBoxFor(x => x.Numero, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.Numero, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Tipo)

                @Html.DropDownListFor(
                    x => x.Tipo,
                    new SelectList(Enum.GetValues(typeof(TipoVivienda))),
                    "Seleccione un Tipo",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(x => x.Tipo, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Estado)

                @Html.DropDownListFor(
                    x => x.Estado,
                    new SelectList(Enum.GetValues(typeof(EstadoGeneral))),
                    "Seleccione un estado",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(x => x.Estado, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <button class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>

