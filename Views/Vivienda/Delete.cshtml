@model proyecto_programacion_avanzada.ViewModels.Vivienda.ViviendaDetailsViewModel

@{
    ViewBag.Title = "Eliminar Vivienda";
}

<div class="card shadow mx-auto" style="max-width: 640px;">
    <div class="card-header bg-danger text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-trash-alt me-2"></i>Eliminar Vivienda</h2>
    </div>

    <div class="card-body">
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            ¿Desea eliminar la vivienda <strong>Bloque: @Model.Bloque - Número: @Model.Numero</strong>?
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(x => x.IdVivienda)

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-danger">
                    <i class="fas fa-trash-alt me-1"></i>Eliminar
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Cancelar</a>
            </div>
        }
    </div>
</div>

