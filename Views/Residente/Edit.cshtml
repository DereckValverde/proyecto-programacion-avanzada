@model Condominio.Application.ViewModels.Residente.ResidenteEditViewModel
@using Condominio.Domain.Enums

@{
    ViewBag.Title = "Editar Residente";
}

<div class="card shadow mx-auto" style="max-width: 760px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-edit me-2"></i>Editar Residente</h2>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.IdResidente)

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(m => m.Nombre)
                @Html.EditorFor(m => m.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(m => m.Nombre)
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.FechaIngreso)
                @Html.TextBoxFor(m => m.FechaIngreso, "{0:yyyy-MM-dd}",
                    new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.FechaIngreso)
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Estado)

                @Html.DropDownListFor(
                    m => m.Estado,
                    new SelectList(Enum.GetValues(typeof(EstadoGeneral))),
                    "Seleccione un estado",
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.Estado)
            </div>

            <div class="form-group">
                <label>Usuario</label>

                @Html.DropDownListFor(
                    m => m.IdUsuario,
                    (SelectList)ViewBag.Usuarios,
                    "Seleccione un usuario",
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.IdUsuario)
            </div>

            <div class="form-group">
                <label>Vivienda</label>

                @Html.DropDownListFor(
                    m => m.IdVivienda,
                    (IEnumerable<SelectListItem>)ViewBag.Viviendas,
                    "Seleccione una vivienda",
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.IdVivienda)
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <button class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Actualizar
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>

