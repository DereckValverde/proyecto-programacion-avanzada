@using Condominio.Domain.Shared
@model IEnumerable<Condominio.Application.Residentes.ResidenteListViewModel>

@{
    ViewBag.Title = "Residentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-id-card me-2"></i>Residentes</h2>

    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-id-card me-1"></i>Nuevo Residente
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-id-card"></i>
                No hay residentes registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Fecha Ingreso</th>
                            <th>Estado</th>
                            <th>Vivienda</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.FechaIngreso.ToShortDateString()</td>
                                <td>
                                    @if (item.Estado == EstadoGeneral.Activo)
                                    {
                                        <span class="badge bg-success">@item.EstadoNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.EstadoNombre</span>
                                    }
                                </td>
                                <td>@item.Vivienda</td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Details", new { id = item.IdResidente },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @Html.ActionLink(" ", "Delete", new { id = item.IdResidente },
                                        new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
