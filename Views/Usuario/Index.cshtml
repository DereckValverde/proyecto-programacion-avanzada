@using proyecto_programacion_avanzada.Common.Enums;
@model IEnumerable<proyecto_programacion_avanzada.ViewModels.Usuario.UsuarioListViewModel>

@{
    ViewBag.Title = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-users me-2"></i>Gestión de Usuarios</h2>

    @Html.ActionLink(" Nuevo Usuario", "Create", null,
        new { @class = "btn btn-primary" })
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-users"></i>
                No hay usuarios registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.Correo</td>
                                <td>@item.Telefono</td>
                                <td>
                                    <span class="badge bg-secondary">@item.RolNombre</span>
                                </td>
                                <td>
                                    @if (item.Estado == EstadoGeneral.Activo)
                                    {
                                        <span class="badge bg-success">@item.EstadoNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.EstadoNombre</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Edit", new { id = item.IdUsuario },
                                        new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })

                                    @Html.ActionLink(" ", "Details", new { id = item.IdUsuario },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @Html.ActionLink(" ", "Delete", new { id = item.IdUsuario },
                                        new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
