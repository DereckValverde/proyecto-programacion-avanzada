@model Condominio.Application.Incidencias.IncidenciaCreateViewModel
@using Condominio.Domain.Incidencias

@{
    ViewBag.Title = "Reportar Incidencia";
}

<div class="card shadow mx-auto" style="max-width: 760px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Reportar Incidencia</h2>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.IdResidente)

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Descripcion, new { @class = "form-label d-block" })
                @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 5, placeholder = "Describa el problema que desea reportar" })
                @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Prioridad, new { @class = "form-label d-block" })
                @Html.DropDownListFor(
                    m => m.Prioridad,
                    new SelectList(Enum.GetValues(typeof(PrioridadIncidencia))),
                    "Seleccione una prioridad",
                    new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.Prioridad, "", new { @class = "text-danger" })
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <button class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Reportar
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>
