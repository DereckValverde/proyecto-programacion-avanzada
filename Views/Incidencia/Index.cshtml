@model IEnumerable<Condominio.Application.Incidencias.IncidenciaListViewModel>
@using Condominio.Domain.Incidencias

@{
    ViewBag.Title = "Incidencias";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2><i class="fas fa-exclamation-circle me-2"></i>Incidencias</h2>

    @if (ViewBag.EsResidente == true)
    {
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Reportar incidencia
        </a>
    }
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-exclamation-circle"></i>
                No hay incidencias registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Descripción</th>
                            <th>Residente</th>
                            <th>Vivienda</th>
                            <th>Fecha de Reporte</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Descripcion</td>
                                <td>@item.NombreResidente</td>
                                <td>@item.NombreVivienda</td>
                                <td>@item.FechaReporte.ToString("g")</td>
                                <td>
                                    @if (item.Prioridad == PrioridadIncidencia.Alta)
                                    {
                                        <span class="badge bg-danger">@item.PrioridadNombre</span>
                                    }
                                    else if (item.Prioridad == PrioridadIncidencia.Media)
                                    {
                                        <span class="badge bg-warning text-dark">@item.PrioridadNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.PrioridadNombre</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Estado == EstadoIncidencia.Resuelta)
                                    {
                                        <span class="badge bg-success">@item.EstadoNombre</span>
                                    }
                                    else if (item.Estado == EstadoIncidencia.EnProceso)
                                    {
                                        <span class="badge bg-warning text-dark">@item.EstadoNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.EstadoNombre</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Details", new { id = item.IdIncidencia },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @if (ViewBag.EsResidente != true)
                                    {
                                        @Html.ActionLink(" ", "Edit", new { id = item.IdIncidencia },
                                            new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })
                                    }

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        @Html.ActionLink(" ", "Delete", new { id = item.IdIncidencia },
                                            new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
