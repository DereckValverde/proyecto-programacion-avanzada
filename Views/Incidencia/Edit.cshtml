@model Condominio.Application.Incidencias.IncidenciaEditViewModel
@using Condominio.Domain.Incidencias

@{
    ViewBag.Title = "Editar Incidencia";
}

<div class="card shadow mx-auto" style="max-width: 760px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-edit me-2"></i>Editar Incidencia</h2>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.IdIncidencia)

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group mb-3">
                <label class="form-label d-block">Descripción</label>
                <textarea class="form-control" rows="5" disabled="disabled">@Model.Descripcion</textarea>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label class="form-label d-block">Residente</label>
                    <input type="text" class="form-control" value="@Model.NombreResidente" disabled="disabled" />
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label d-block">Vivienda</label>
                    <input type="text" class="form-control" value="@Model.NombreVivienda" disabled="disabled" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="form-label d-block">Fecha de reporte</label>
                <input type="text" class="form-control" value="@Model.FechaReporte.ToString("g")" disabled="disabled" />
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    @Html.LabelFor(m => m.Prioridad, new { @class = "form-label d-block" })
                    @Html.DropDownListFor(
                        m => m.Prioridad,
                        new SelectList(Enum.GetValues(typeof(PrioridadIncidencia))),
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Prioridad, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 form-group mb-3">
                    @Html.LabelFor(m => m.Estado, new { @class = "form-label d-block" })
                    @Html.DropDownListFor(
                        m => m.Estado,
                        new SelectList(Enum.GetValues(typeof(EstadoIncidencia))),
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <button class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Actualizar
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>
