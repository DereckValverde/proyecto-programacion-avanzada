@model IEnumerable<Condominio.Application.Pagos.PagoListViewModel>

@{
    ViewBag.Title = "Pagos";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2><i class="fas fa-money-bill-wave me-2"></i>Pagos</h2>

    <div class="d-flex gap-2 align-items-center">
        <div class="btn-group" role="group">
            @Html.ActionLink("Todos", "Index", null,
                new { @class = "btn btn-sm btn-outline-secondary" + (ViewBag.Filtro == null ? " active" : "") })

            @Html.ActionLink("Pendientes", "Index", new { filtro = "pendientes" },
                new { @class = "btn btn-sm btn-outline-secondary" + ((string)ViewBag.Filtro == "pendientes" ? " active" : "") })

            @Html.ActionLink("Pagados", "Index", new { filtro = "pagados" },
                new { @class = "btn btn-sm btn-outline-secondary" + ((string)ViewBag.Filtro == "pagados" ? " active" : "") })

            @Html.ActionLink("Atrasados", "Index", new { filtro = "atrasados" },
                new { @class = "btn btn-sm btn-outline-secondary" + ((string)ViewBag.Filtro == "atrasados" ? " active" : "") })
        </div>

        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Registrar pago
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-money-bill-wave"></i>
                No hay pagos registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Vivienda</th>
                            <th>Periodo</th>
                            <th>Monto</th>
                            <th>Fecha de Pago</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.NombreVivienda</td>
                                <td>@item.Periodo</td>
                                <td>@item.Monto.ToString("C")</td>
                                <td>@item.FechaPago.ToString("d")</td>
                                <td>
                                    @if (item.Estado == Condominio.Domain.Pagos.EstadoPago.Pagado)
                                    {
                                        <span class="badge bg-success">@item.EstadoNombre</span>
                                    }
                                    else if (item.Estado == Condominio.Domain.Pagos.EstadoPago.Atrasado)
                                    {
                                        <span class="badge bg-danger">@item.EstadoNombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.EstadoNombre</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Details", new { id = item.IdPago },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @if (ViewBag.EsResidente != true)
                                    {
                                        @Html.ActionLink(" ", "Edit", new { id = item.IdPago },
                                            new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })

                                        @Html.ActionLink(" ", "Delete", new { id = item.IdPago },
                                            new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
