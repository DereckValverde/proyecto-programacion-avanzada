@model Condominio.Application.Pagos.PagoCreateViewModel
@using Condominio.Domain.Pagos

@{
    ViewBag.Title = "Registrar Pago";
}

<div class="card shadow mx-auto" style="max-width: 760px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-money-bill-wave me-2"></i>Registrar Pago</h2>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            if (ViewBag.EsResidente == true)
            {
                @Html.HiddenFor(m => m.IdVivienda)

                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.IdVivienda, "Vivienda", new { @class = "form-label d-block" })
                    <input type="text" class="form-control" value="@ViewBag.ViviendaResidente" disabled="disabled" />
                </div>
            }
            else
            {
                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.IdVivienda, "Vivienda", new { @class = "form-label d-block" })
                    @Html.DropDownListFor(
                        m => m.IdVivienda,
                        (IEnumerable<SelectListItem>)ViewBag.Viviendas,
                        "Seleccione una vivienda",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.IdVivienda, "", new { @class = "text-danger" })
                </div>
            }

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Periodo, new { @class = "form-label d-block" })
                @Html.EditorFor(m => m.Periodo, new { htmlAttributes = new { @class = "form-control", placeholder = "AAAA-MM" } })
                @Html.ValidationMessageFor(m => m.Periodo, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.Monto, new { @class = "form-label d-block" })
                @Html.EditorFor(m => m.Monto, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01" } })
                @Html.ValidationMessageFor(m => m.Monto, "", new { @class = "text-danger" })
            </div>

            <div class="form-group mb-3">
                @Html.LabelFor(m => m.FechaPago, new { @class = "form-label d-block" })
                @Html.TextBoxFor(m => m.FechaPago, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.FechaPago, "", new { @class = "text-danger" })
            </div>

            if (ViewBag.EsResidente != true)
            {
                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.Estado, new { @class = "form-label d-block" })
                    @Html.DropDownListFor(
                        m => m.Estado,
                        new SelectList(Enum.GetValues(typeof(EstadoPago))),
                        "Seleccione un estado",
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
                </div>
            }

            <div class="d-flex justify-content-center gap-2 mt-4">
                <button class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Registrar pago
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>
