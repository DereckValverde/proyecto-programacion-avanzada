@model IEnumerable<Condominio.Application.ViewModels.Noticia.NoticiaListViewModel>

@{
    ViewBag.Title = "Noticias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-bullhorn me-2"></i>Gestión de Noticias y Alertas</h2>

    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fas fa-bullhorn me-1"></i>Nueva Noticia
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-bullhorn"></i>
                No hay noticias ni alertas registradas.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Título</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th>Autor</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Titulo</td>
                                <td>
                                    @if (item.EsAlerta)
                                    {
                                        <span class="badge bg-warning text-dark">Alerta</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Noticia</span>
                                    }
                                </td>
                                <td>@item.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                                <td>@item.Autor</td>
                                <td class="text-end text-nowrap">
                                    @Html.ActionLink(" ", "Edit", new { id = item.IdNoticia },
                                        new { @class = "btn btn-sm btn-outline-primary btn-action fas fa-pencil-alt", title = "Editar" })

                                    @Html.ActionLink(" ", "Details", new { id = item.IdNoticia },
                                        new { @class = "btn btn-sm btn-outline-info btn-action fas fa-eye", title = "Detalles" })

                                    @Html.ActionLink(" ", "Delete", new { id = item.IdNoticia },
                                        new { @class = "btn btn-sm btn-outline-danger btn-action fas fa-trash-alt", title = "Eliminar" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
