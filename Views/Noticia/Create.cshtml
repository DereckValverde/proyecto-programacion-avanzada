@model Condominio.Application.Noticias.NoticiaCreateViewModel

@{
    ViewBag.Title = "Nueva Noticia";
}

<div class="card shadow mx-auto" style="max-width: 760px;">
    <div class="card-header bg-primary text-white">
        <h2 class="page-heading mb-0"><i class="fas fa-bullhorn me-2"></i>Nueva Noticia o Alerta</h2>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(x => x.Titulo)
                @Html.TextBoxFor(x => x.Titulo, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.Titulo, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Contenido)
                @Html.TextAreaFor(x => x.Contenido, new { @class = "form-control", rows = 6 })
                @Html.ValidationMessageFor(x => x.Contenido, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(x => x.Autor)
                @Html.TextBoxFor(x => x.Autor, new { @class = "form-control" })
                @Html.ValidationMessageFor(x => x.Autor, "", new { @class = "text-danger" })
            </div>

            <div class="form-group form-check">
                @Html.CheckBoxFor(x => x.EsAlerta, new { @class = "form-check-input" })
                @Html.LabelFor(x => x.EsAlerta, new { @class = "form-check-label" })
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <button class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>

                <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        }
    </div>
</div>

